# SPDX-License-Identifier: GPL-2.0-only
CONFIG_64BIT=y
CONFIG_ARM64=y
CONFIG_ARCH_AIROHA=y
CONFIG_SMP=y
CONFIG_NR_CPUS=4
CONFIG_ARM_PSCI_FW=y
CONFIG_ARM_GIC_V3=y
CONFIG_ARM_ARCH_TIMER=y
CONFIG_PCI=y
CONFIG_PCIE_MEDIATEK_GEN3=y
CONFIG_PCI_MSI=y
# PCIe AER: both the root port and the MT7996 implement it, so link errors
# are reported instead of silent.
CONFIG_PCIEPORTBUS=y
CONFIG_PCIEAER=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_TTY=y
CONFIG_UNIX98_PTYS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_BLOCK=y
CONFIG_BLK_DEV=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_XATTR=y
CONFIG_OVERLAY_FS=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_PRINTK=y
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_NET=y
CONFIG_INET=y
CONFIG_UNIX=y
CONFIG_PACKET=y
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_NET_VENDOR_AIROHA=y
CONFIG_NET_AIROHA=y
CONFIG_NET_DSA=y
CONFIG_NET_DSA_MT7530=y
CONFIG_NET_DSA_MT7530_MMIO=y
CONFIG_PHYLIB=y
CONFIG_REALTEK_PHY=y
# The 10 GbE ports: AN7581 USXGMII PCS and RTL8261N PHYs (RTL8261CE on the
# W1700K2). Both PHY patches are built in because a probe without one leaves
# the PHY in reset for good; the build supplies CONFIG_EXTRA_FIRMWARE_DIR.
CONFIG_PCS_AIROHA_AN7581=y
CONFIG_EXTRA_FIRMWARE="rtl8261n.bin rtl_nic/rtl8261c.bin"
CONFIG_FIXED_PHY=y
CONFIG_FW_LOADER=y
CONFIG_I2C=y
CONFIG_HWMON=y
CONFIG_SENSORS_NCT7802=y
CONFIG_GPIO_CDEV=y
CONFIG_PPS=y
CONFIG_PTP_1588_CLOCK=y
CONFIG_NVMEM=y
CONFIG_DEBUG_FS=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
# CONFIG_WLAN is not set
# CONFIG_BT is not set
# CONFIG_NETFILTER is not set
# CONFIG_BRIDGE is not set
CONFIG_COMMON_CLK_EN7523=y
CONFIG_PINCTRL=y
CONFIG_PINCTRL_AIROHA=y
CONFIG_RESET_CONTROLLER=y
CONFIG_PHY_AIROHA_PCIE=y
CONFIG_PHY_AIROHA_USB=y
CONFIG_SERIAL_8250_EXTENDED=y
CONFIG_SERIAL_8250_AIROHA=y
CONFIG_SERIAL_8250_NR_UARTS=5
CONFIG_SERIAL_8250_RUNTIME_UARTS=5
CONFIG_I2C_MT7621=y
# CONFIG_NET_AIROHA_NPU is not set
CONFIG_PINCTRL_AIROHA_AN7581=y
# CONFIG_PINCTRL_AIROHA_AN7583 is not set
CONFIG_MEDIATEK_GE_SOC_PHY=y
CONFIG_PM=y
CONFIG_CPU_FREQ=y
CONFIG_ARM_AIROHA_SOC_CPUFREQ=y
CONFIG_AIROHA_CPU_PM_DOMAIN=y
CONFIG_CPU_THERMAL=y
CONFIG_CPU_FREQ_THERMAL=y
CONFIG_THERMAL=y
CONFIG_THERMAL_OF=y
CONFIG_MFD_SYSCON=y
CONFIG_AIROHA_THERMAL=y
CONFIG_WATCHDOG=y
CONFIG_AIROHA_WATCHDOG=y
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_AIROHA=y
# CONFIG_NET_AIROHA_FLOW_STATS is not set
CONFIG_SPI=y
CONFIG_SPI_MASTER=y
CONFIG_SPI_AIROHA_SNFI=y
CONFIG_MTD=y
CONFIG_MTD_SPI_NAND=y
# CONFIG_MTD_PARTITIONED_MASTER is not set
CONFIG_MTD_OF_PARTS=y
CONFIG_MTD_CMDLINE_PARTS=y
CONFIG_MTD_BLOCK=y
# CONFIG_MTD_RAW_NAND is not set
# CONFIG_MTD_SPI_NOR is not set
CONFIG_MTD_UBI=y
CONFIG_MTD_UBI_WL_THRESHOLD=4096
CONFIG_MTD_UBI_BEB_LIMIT=20
CONFIG_MTD_UBI_BLOCK=y
CONFIG_MISC_FILESYSTEMS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_UBIFS_FS=y
CONFIG_UBIFS_FS_LZO=y
# CONFIG_MTD_NAND_MTK_BMT is not set
CONFIG_AIROHA_SDR_BMT=y
CONFIG_AIROHA_SDR_BMT_WRITE=y
CONFIG_CRYPTO_LIB_SHA256=y
# CONFIG_SPI_SPIDEV is not set
